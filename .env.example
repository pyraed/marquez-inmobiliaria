# ============================================================
# MarQuez Negocios Inmobiliarios — Variables de entorno
# ============================================================
# Copiá este archivo como .env.local y completá los valores reales.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- SUPABASE ---
# Encontrás estos valores en:
# Supabase Dashboard → tu proyecto → Settings → API

# URL del proyecto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co

# Clave pública anónima (anon / public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- SITIO ---
# Dominio completo del sitio (sin barra final)
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000
